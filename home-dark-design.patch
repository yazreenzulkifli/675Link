+
+    /**
+     * Home-screen chrome that mirrors [ConnectionState]: header dot, status badge, bike pill and the
+     * telemetry mini-grid. Everything shown here is real data — the bike doesn't report battery
+     * voltage over this link, so the "Phone" tile shows the phone's own battery. To feed new live
+     * values (e.g. bike telemetry), extend [HomeTelemetry] and set them here.
+     */
+    private fun renderHome(phase: Phase) {
+        val live = phase == Phase.STREAMING || phase == Phase.MIRRORING
+        if (live) lastLiveAt = System.currentTimeMillis()
+        val saved = BikeMemory.hasSaved(this)
+
+        val (badgeRes, badgeColorRes) = when {
+            phase == Phase.ERROR -> R.string.home_badge_error to R.color.status_error
+            live -> R.string.home_badge_live to R.color.accent_emerald
+            phase.busy -> R.string.home_badge_linking to R.color.accent_cyan_2
+            saved -> R.string.home_badge_paired to R.color.accent_orange
+            else -> R.string.home_badge_ready to R.color.accent_orange
+        }
+        val badgeColor = ContextCompat.getColor(this, badgeColorRes)
+        findViewById<TextView>(R.id.home_status_badge)?.apply {
+            setText(badgeRes)
+            setTextColor(badgeColor)
+        }
+        val tint = android.content.res.ColorStateList.valueOf(badgeColor)
+        findViewById<View>(R.id.home_status_dot)?.backgroundTintList = tint
+        findViewById<View>(R.id.home_status_badge_wrap)?.backgroundTintList =
+            android.content.res.ColorStateList.valueOf((badgeColor and 0x00FFFFFF) or 0x26000000)
+        findViewById<View>(R.id.home_link_dot)?.apply {
+            backgroundTintList = tint
+            animate().cancel()
+            alpha = 1f
+            if (phase.busy || live) pulse(this)
+        }
+        findViewById<TextView>(R.id.home_link_label)?.text = "· ${getString(phase.labelRes)}"
+
+        findViewById<TextView>(R.id.bike_pill)?.text =
+            BikeMemory.lastBikeName(this)?.let { "${it.uppercase()} ▾" } ?: getString(R.string.home_no_bike)
+
+        renderTelemetry(
+            HomeTelemetry(
+                phoneBatteryPct = phoneBatteryPct(),
+                linkRes = when (phase) {
+                    Phase.STREAMING, Phase.STARTING_AA, Phase.AA_VIDEO_LIVE -> R.string.home_link_aa
+                    Phase.MIRRORING -> R.string.home_link_mirror
+                    Phase.JOINING_WIFI, Phase.PXC_CONNECTING, Phase.RECONNECTING,
+                    Phase.WAITING_FOR_BIKE -> R.string.home_link_wifi
+                    else -> R.string.home_link_off
+                },
+                lastSyncAt = lastLiveAt,
+                live = live,
+            ),
+        )
+    }
+
+    /** Values for the telemetry mini-grid; hook a real state provider in by building one of these. */
+    private data class HomeTelemetry(
+        val phoneBatteryPct: Int?,
+        @androidx.annotation.StringRes val linkRes: Int,
+        val lastSyncAt: Long,
+        val live: Boolean,
+    )
+
+    private fun renderTelemetry(t: HomeTelemetry) {
+        findViewById<TextView>(R.id.tel_phone)?.text =
+            t.phoneBatteryPct?.let { "⚡ $it%" } ?: getString(R.string.home_tel_none)
+        findViewById<TextView>(R.id.tel_link)?.setText(t.linkRes)
+        findViewById<TextView>(R.id.tel_sync)?.text = when {
+            t.live -> getString(R.string.home_sync_now)
+            t.lastSyncAt <= 0L -> getString(R.string.home_tel_none)
+            else -> {
+                val mins = ((System.currentTimeMillis() - t.lastSyncAt) / 60_000L).toInt()
+                when {
+                    mins < 1 -> getString(R.string.home_sync_now)
+                    mins < 60 -> getString(R.string.home_sync_min, mins)
+                    else -> getString(R.string.home_sync_hr, mins / 60)
+                }
+            }
+        }
+    }
