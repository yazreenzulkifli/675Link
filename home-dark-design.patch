+<?xml version="1.0" encoding="utf-8"?>
+<!-- Tactile press feedback for home-screen controls: a quick shrink while held. -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:state_pressed="true">
+        <set>
+            <objectAnimator android:duration="90" android:propertyName="scaleX" android:valueTo="0.96" android:valueType="floatType" />
+            <objectAnimator android:duration="90" android:propertyName="scaleY" android:valueTo="0.96" android:valueType="floatType" />
+        </set>
+    </item>
+    <item>
+        <set>
+            <objectAnimator android:duration="140" android:propertyName="scaleX" android:valueTo="1.0" android:valueType="floatType" />
+            <objectAnimator android:duration="140" android:propertyName="scaleY" android:valueTo="1.0" android:valueType="floatType" />
+        </set>
+    </item>
+</selector>
