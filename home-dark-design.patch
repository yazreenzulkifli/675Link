+    private fun phoneBatteryPct(): Int? = try {
+        val bm = getSystemService(Context.BATTERY_SERVICE) as? android.os.BatteryManager
+        bm?.getIntProperty(android.os.BatteryManager.BATTERY_PROPERTY_CAPACITY)?.takeIf { it in 0..100 }
+    } catch (_: Exception) {
+        null
+    }
