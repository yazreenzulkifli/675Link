<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- A dark "cockpit" theme with a CFMoto-orange accent. Dark is intentional: this runs on a
         bike in daylight/handlebar context and mirrors a commercial head-unit look. -->
    <style name="Base.Theme.OpenCfMoto" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_orange_dark</item>
        <item name="colorOnPrimaryContainer">@color/on_brand</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_high</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>

        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Every popup uses the Aero Glaze look (see GlassAlertBuilder / HeadUnitDialog). -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.OpenCfMoto.GlassDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.OpenCfMoto.GlassDialog</item>
    </style>

    <style name="Theme.OpenCfMoto" parent="Base.Theme.OpenCfMoto" />

    <!-- ===== Aero Glaze popups: dark frosted card, cyan primary, glass ghost buttons ===== -->
    <style name="Base.ThemeOverlay.OpenCfMoto.GlassDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/glass_cyan_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/glass_cyan_light</item>
        <item name="colorSurface">#FF111827</item>
        <item name="colorSurfaceContainerHigh">#FF111827</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">#FFCBD5E1</item>
        <item name="colorOutline">#40FFFFFF</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">#FFCBD5E1</item>
        <item name="android:backgroundDimAmount">0.65</item>
        <item name="android:windowAnimationStyle">@style/Animation.OpenCfMoto.GlassDialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/GlassDialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/GlassDialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/GlassDialog.Button.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/GlassDialog.Button.Ghost</item>
        <item name="buttonBarNeutralButtonStyle">@style/GlassDialog.Button.Ghost</item>
    </style>
    <style name="ThemeOverlay.OpenCfMoto.GlassDialog" parent="Base.ThemeOverlay.OpenCfMoto.GlassDialog" />

    <style name="Animation.OpenCfMoto.GlassDialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/glass_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/glass_dialog_exit</item>
    </style>

    <style name="GlassDialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GlassDialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">#E6CBD5E1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <!-- Cyan pill = the main action; glass outline = Cancel / secondary. -->
    <style name="GlassDialog.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/home_cyan</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="GlassDialog.Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">#FFCBD5E1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">#0DFFFFFF</item>
        <item name="strokeColor">#26FFFFFF</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Primary CTA: tall, rounded, confident. Height grows with font scale. -->
    <style name="Widget.OpenCfMoto.Button.Connect" parent="Widget.Material3.Button">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/btn_connect_min_height</item>
        <item name="android:textSize">@dimen/btn_connect_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/btn_icon_padding</item>
    </style>

    <!-- Secondary actions: tonal. Icon beside text (not above) so labels stay horizontal. -->
    <style name="Widget.OpenCfMoto.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/btn_tonal_min_height</item>
        <item name="android:textSize">@dimen/btn_tonal_text</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/btn_icon_padding</item>
        <item name="iconSize">20dp</item>
    </style>

    <!-- Icon-above tile (Scan / Map / Mirror). Uses auto-size so labels never go vertical. -->
    <style name="Widget.OpenCfMoto.Button.Tile" parent="Widget.OpenCfMoto.Button.Tonal">
        <item name="android:minHeight">@dimen/btn_tile_min_height</item>
        <item name="android:textSize">@dimen/btn_tile_text</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">@dimen/btn_tile_icon_padding</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">@dimen/btn_tile_text_min</item>
        <item name="autoSizeMaxTextSize">@dimen/btn_tile_text</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <!-- Text/ghost actions for the log toolbar. -->
    <style name="Widget.OpenCfMoto.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
    </style>

    <!-- Segmented-control option (selection highlight is applied in code). -->
    <style name="Widget.OpenCfMoto.Segment" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/btn_segment_text</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/btn_segment_min_height</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Card.OpenCfMoto" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">20dp</item>
    </style>

    <style name="Card.OpenCfMoto.Log" parent="Card.OpenCfMoto">
        <item name="cardCornerRadius">18dp</item>
        <item name="contentPadding">10dp</item>
    </style>

    <!-- ===== Home screen — light "glaze" style (home only; rest of app stays dark) ===== -->
    <style name="Card.OpenCfMoto.HomeLight" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">26dp</item>
        <item name="cardBackgroundColor">@color/home_card</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeColor">@color/home_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
        <item name="android:outlineSpotShadowColor">#330F172A</item>
        <item name="android:outlineAmbientShadowColor">#1A0F172A</item>
    </style>

    <!-- Hero CTA pill. The cyan / red gradient is applied in MainActivity (MaterialButton ignores
         android:background from XML). -->
    <style name="Widget.OpenCfMoto.HomeLight.Cta" parent="Widget.OpenCfMoto.Button.Connect">
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="iconTint">@color/white</item>
        <item name="iconSize">22dp</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:stateListAnimator">@animator/home_press</item>
    </style>

    <!-- "+ Scan QR" button in the Pair TFT card. -->
    <style name="Widget.OpenCfMoto.HomeLight.Scan" parent="Widget.Material3.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:maxLines">1</item>
        <item name="backgroundTint">@color/home_text</item>
        <item name="iconTint">@color/white</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:stateListAnimator">@animator/home_press</item>
    </style>

    <!-- Quick utility pills (Setup / Garage / Trip / Logs). -->
    <style name="Widget.OpenCfMoto.HomeLight.Pill" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">46dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="backgroundTint">@color/home_card</item>
        <item name="strokeColor">@color/home_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#2200B4D8</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:stateListAnimator">@animator/home_press</item>
    </style>

    <!-- Bottom dock tabs (Dash view / Controls / Map / Mirror). -->
    <style name="Widget.OpenCfMoto.HomeLight.Dock" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">60dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/home_text_2</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="iconTint">@color/home_text_2</item>
        <item name="iconSize">22dp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">2dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="rippleColor">#2200B4D8</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">9sp</item>
        <item name="autoSizeMaxTextSize">11sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="android:stateListAnimator">@animator/home_press</item>
    </style>

    <!-- Bold orange GO pill in the search bar. -->
    <style name="Widget.OpenCfMoto.HomeLight.Go" parent="Widget.Material3.Button">
        <item name="android:minHeight">46dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/home_orange</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:stateListAnimator">@animator/home_press</item>
    </style>

    <!-- Full-width outline utility buttons in the field guide. -->
    <style name="Widget.OpenCfMoto.HomeLight.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="strokeColor">@color/home_border</item>
        <item name="iconTint">@color/home_cyan</item>
        <item name="iconSize">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">100dp</item>
        <item name="rippleColor">#2200B4D8</item>
        <item name="android:stateListAnimator">@animator/home_press</item>
    </style>

    <style name="Widget.OpenCfMoto.HomeLight.Link" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/home_text_2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="HomeGlanceLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/home_text_2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="HomeGlanceValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="HomeGuideNum">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/home_num_badge</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/home_cyan</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeGuideTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeGuideBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/home_text_2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Trip computer stat tiles. -->
    <style name="TripStatLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TripStatValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Dash View chrome: tactile glass button, and the cyan Select variant. -->
    <style name="HudBtn" parent="">
        <item name="android:background">@drawable/hud_btn</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@animator/home_press</item>
    </style>
    <style name="HudBtn.Select">
        <item name="android:background">@drawable/hud_btn_cyan</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="SetupStepBadge">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/setup_badge_todo</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
