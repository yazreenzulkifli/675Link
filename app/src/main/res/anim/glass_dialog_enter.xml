<?xml version="1.0" encoding="utf-8"?>
<!-- Fade + overshooting scale-up, matching the HeadUnitDialog entrance. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="320"
    android:interpolator="@anim/glass_overshoot">
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <scale
        android:fromXScale="0.9" android:toXScale="1"
        android:fromYScale="0.9" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
</set>
