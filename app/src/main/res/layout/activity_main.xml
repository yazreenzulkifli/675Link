<?xml version="1.0" encoding="utf-8"?>
<!--
  Home screen — light "glaze" smart-mobility redesign.
  Every id referenced by MainActivity is kept (btn_connect, btn_aa_start, status_view, …) so the
  existing logic keeps working. New ids (home_*, tel_*, btn_header_*) are driven by
  MainActivity.renderHome(). Only real data is shown: connection phase, saved bike, link mode,
  last time the dash was live, and the phone's own battery.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_gradient"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- ===== 1. Top header ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btn_header_about"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/home_icon_circle"
            android:contentDescription="@string/home_about"
            android:elevation="1dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info"
            android:stateListAnimator="@animator/home_press"
            android:tint="@color/home_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Animated 675 logo (GIF, played by MainActivity); tap → Garage. -->
                <ImageView
                    android:id="@+id/brand_logo"
                    android:layout_width="130dp"
                    android:layout_height="52dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/home_default_title"
                    android:scaleType="centerCrop" />
            </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_header_settings"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/home_icon_circle"
            android:contentDescription="@string/home_settings"
            android:elevation="1dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            android:stateListAnimator="@animator/home_press"
            android:tint="@color/home_text" />
    </LinearLayout>

    <!-- Scrollable body. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/home_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="16dp">

            <!-- ===== 2. Hero vehicle showcase & quick telemetry ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.OpenCfMoto.HomeLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:contentPadding="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/home_hero_glow"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Mode pill (link) + status pill -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:id="@+id/home_status_badge_wrap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/home_pill"
                            android:backgroundTint="@color/home_mint_soft"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp">

                            <View
                                android:id="@+id/home_status_dot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/home_dot"
                                android:backgroundTint="@color/home_mint" />

                            <TextView
                                android:id="@+id/home_status_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/home_badge_ready"
                                android:textColor="@color/home_mint"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Bike illustration with floating status pill -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <!-- Swipe: page 1 = bike photo (tap to switch variant), page 2 = live trip
                             speed (home_hero_speed.xml). Pages are built in MainActivity.setupHeroPager. -->
                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/home_hero_pager"
                            android:layout_width="match_parent"
                            android:layout_height="196dp" />

                        <LinearLayout
                            android:id="@+id/home_hero_dots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|center_horizontal"
                            android:orientation="horizontal" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:background="@drawable/home_pill"
                            android:elevation="4dp"
                            android:gravity="center_vertical"
                            android:minHeight="40dp"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="14dp">

                            <ImageView
                                android:id="@+id/status_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@drawable/home_num_badge"
                                android:contentDescription="@string/main_connection_status"
                                android:padding="4dp"
                                android:src="@drawable/ic_ride"
                                android:tint="@color/status_idle" />

                            <TextView
                                android:id="@+id/status_view"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:maxWidth="220dp"
                                android:text="@string/main_ready"
                                android:textColor="@color/home_text"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <ProgressBar
                        android:id="@+id/status_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/home_cyan"
                        android:visibility="gone" />

                    <!-- Dual glance cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/tel_perm_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/home_glance_bg"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/tel_perm_icon"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_perm_shield"
                                    android:tint="@color/home_red" />

                                <TextView
                                    android:id="@+id/tel_perm_label"
                                    style="@style/HomeGlanceLabel"
                                    android:layout_width="0dp"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:text="@string/home_tel_perm" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tel_top_speed"
                                style="@style/HomeGlanceValue"
                                android:text="@string/home_perm_missing"
                                tools:text="Allowed" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tel_dev_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/home_glance_bg"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/tel_dev_icon"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_dev_code"
                                    android:tint="@color/home_red" />

                                <TextView
                                    android:id="@+id/tel_dev_label"
                                    style="@style/HomeGlanceLabel"
                                    android:layout_width="0dp"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:text="@string/home_tel_dev" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tel_dev_value"
                                style="@style/HomeGlanceValue"
                                android:text="@string/home_dev_unknown"
                                tools:text="Enabled" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/tel_unit_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/home_glance_bg"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/tel_unit_dot"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:importantForAccessibility="no"
                                    android:padding="3dp"
                                    android:src="@drawable/home_dot"
                                    android:tint="@color/home_red" />

                                <TextView
                                    android:id="@+id/tel_unit_label"
                                    style="@style/HomeGlanceLabel"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/home_tel_unit" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tel_sync"
                                style="@style/HomeGlanceValue"
                                android:text="@string/home_unit_offline"
                                android:textColor="@color/home_red"
                                tools:text="Online" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tel_dest_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/home_glance_bg"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/tel_dest_icon"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_dest_pin"
                                    android:tint="@color/home_red" />

                                <TextView
                                    android:id="@+id/tel_dest_label"
                                    style="@style/HomeGlanceLabel"
                                    android:layout_width="0dp"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:text="@string/home_tel_dest" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tel_phone"
                                style="@style/HomeGlanceValue"
                                android:text="@string/home_dest_unset"
                                tools:text="Set" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Phone media volume (nav voice + music) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/home_glance_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp">

                        <TextView
                            style="@style/HomeGlanceLabel"
                            android:text="@string/controls_volume" />

                        <SeekBar
                            android:id="@+id/home_seek_volume"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_weight="1"
                            android:max="15"
                            android:progress="8" />

                        <TextView
                            android:id="@+id/home_volume_value"
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="@string/home_tel_none"
                            android:textColor="@color/home_text"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/home_switch_free_volume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingHorizontal="4dp"
                        android:text="@string/home_free_volume"
                        android:textColor="@color/home_text_2"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 3. Pair CFMoto TFT card ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.OpenCfMoto.HomeLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/home_qr_tile"
                        android:importantForAccessibility="no"
                        android:padding="12dp"
                        android:src="@drawable/ic_qr"
                        android:tint="@color/home_cyan" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/home_pair_title"
                            android:textColor="@color/home_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/bike_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="3"
                            android:ellipsize="end"
                            android:text="@string/main_no_bike_paired_yet"
                            android:textColor="@color/home_text_2"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_aa_start"
                        style="@style/Widget.OpenCfMoto.HomeLight.Scan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_scan_qr" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 4. Primary action (thumb zone) — Connect becomes Stop while linked ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_connect"
                style="@style/Widget.OpenCfMoto.HomeLight.Cta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:elevation="4dp"
                android:text="@string/home_connect_launch" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/home_cta_sub"
                android:textColor="@color/home_text_2"
                android:textSize="12sp" />

            <!-- ===== Quick utility pill row ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_controls"
                    style="@style/Widget.OpenCfMoto.HomeLight.Pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/home_dock_controls" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_trip"
                    style="@style/Widget.OpenCfMoto.HomeLight.Pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:text="@string/main_trip" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_toggle_log"
                    style="@style/Widget.OpenCfMoto.HomeLight.Pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/main_logs" />
            </LinearLayout>

            <!-- Opens the Android Auto app (settings / its own launcher) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_aa"
                style="@style/Widget.OpenCfMoto.HomeLight.Pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/home_open_android_auto" />

            <!-- Hidden: Stop is merged into Connect; keep id for any legacy refs. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_aa_stop"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/main_stop"
                android:visibility="gone" />

            <!-- ===== 5. Destination & GPX search ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/home_search_bg"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="5dp"
                android:paddingVertical="5dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    android:tint="@color/home_text_2" />

                <EditText
                    android:id="@+id/et_destination"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/home_search_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textPostalAddress"
                    android:maxLines="1"
                    android:minHeight="46dp"
                    android:textColor="@color/home_text"
                    android:textColorHint="@color/home_text_2"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_navigate"
                    style="@style/Widget.OpenCfMoto.HomeLight.Go"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/home_search_in_maps" />
            </LinearLayout>

            <!-- ===== 6. Rider field guide & controls ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tips_panel"
                style="@style/Card.OpenCfMoto.HomeLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.06"
                            android:text="@string/home_guide_title"
                            android:textAllCaps="true"
                            android:textColor="@color/home_text_2"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/home_guide_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?android:attr/selectableItemBackground"
                            android:gravity="center"
                            android:minHeight="44dp"
                            android:paddingHorizontal="8dp"
                            android:text="@string/home_guide_help"
                            android:textColor="@color/home_cyan"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/home_guide_steps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView style="@style/HomeGuideNum" android:text="1" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView style="@style/HomeGuideTitle" android:text="@string/home_guide_1_title" />
                                <TextView style="@style/HomeGuideBody" android:text="@string/home_guide_1_body" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <TextView style="@style/HomeGuideNum" android:text="2" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView style="@style/HomeGuideTitle" android:text="@string/home_guide_2_title" />
                                <TextView style="@style/HomeGuideBody" android:text="@string/home_guide_2_body" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <TextView style="@style/HomeGuideNum" android:text="3" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView style="@style/HomeGuideTitle" android:text="@string/home_guide_3_title" />
                                <TextView style="@style/HomeGuideBody" android:text="@string/home_guide_3_body" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <TextView style="@style/HomeGuideNum" android:text="4" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView style="@style/HomeGuideTitle" android:text="@string/home_guide_4_title" />
                                <TextView style="@style/HomeGuideBody" android:text="@string/home_guide_4_body" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_about_page"
                            style="@style/Widget.OpenCfMoto.HomeLight.Outline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="@string/main_about_credits" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_check_update"
                            style="@style/Widget.OpenCfMoto.HomeLight.Outline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="0dp"
                            android:layout_weight="1"
                            android:text="@string/main_check_for_update" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_revamp_yz"
                            style="@style/Widget.OpenCfMoto.HomeLight.Outline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="@string/main_revamp_by_yz" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_donate"
                            style="@style/Widget.OpenCfMoto.HomeLight.Outline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="0dp"
                            android:layout_weight="1"
                            android:text="@string/main_alexandru" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Diagnostics drawer (toggled by the Logs pill). Kept terminal-dark for readability. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/log_panel"
                style="@style/Card.OpenCfMoto.Log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="220dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.08"
                            android:text="@string/main_diagnostics"
                            android:textAllCaps="true"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_share_log"
                            style="@style/Widget.OpenCfMoto.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:text="@string/main_share" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_clear"
                            style="@style/Widget.OpenCfMoto.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:text="@string/main_clear" />
                    </LinearLayout>

                    <ScrollView
                        android:id="@+id/log_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/bg"
                        android:fillViewport="true"
                        android:nestedScrollingEnabled="true"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/log_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/main_logs"
                            android:fontFamily="monospace"
                            android:textColor="#9CDCFE"
                            android:textIsSelectable="true"
                            android:textSize="11sp" />
                    </ScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ===== 7. Persistent bottom dock ===== -->
    <LinearLayout
        android:id="@+id/home_dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/home_dock_bg"
        android:baselineAligned="false"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_hud_view"
            style="@style/Widget.OpenCfMoto.HomeLight.Dock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_dock_dash" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_devices"
            style="@style/Widget.OpenCfMoto.HomeLight.Dock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/garage_garage" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_gpx"
            style="@style/Widget.OpenCfMoto.HomeLight.Dock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_dock_map" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mirror_start"
            style="@style/Widget.OpenCfMoto.HomeLight.Dock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_dock_mirror" />
    </LinearLayout>
</LinearLayout>
