<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trip_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_gradient"
    android:orientation="vertical"
    tools:context=".TripActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/trip_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/home_icon_circle"
            android:contentDescription="@string/trip_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/home_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/trip_phone_gps"
            android:textColor="@color/home_text"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Hero speedometer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/trip_card_bg"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="20dp">

                <FrameLayout
                    android:layout_width="230dp"
                    android:layout_height="230dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/trip_gauge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="1000"
                        android:progress="0"
                        app:indicatorColor="@color/home_cyan"
                        app:indicatorSize="230dp"
                        app:trackColor="@color/home_cyan_soft"
                        app:trackCornerRadius="12dp"
                        app:trackThickness="16dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/trip_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:includeFontPadding="false"
                            android:text="@string/margins_0"
                            android:textColor="@color/home_text"
                            android:textSize="84sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/trip_speed_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.15"
                            android:text="@string/trip_kmh_caps"
                            android:textColor="@color/home_text_2"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="30dp"
                        android:text="@string/margins_0"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="24dp"
                        android:text="@string/trip_gauge_max"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/home_glance_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_trip_sat"
                        app:tint="@color/home_cyan" />

                    <TextView
                        android:id="@+id/trip_gps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/trip_waiting_for_gps"
                        android:textColor="@color/home_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Telemetry grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/trip_tile_bg"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TripStatLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/trip_distance"
                            android:textColor="#94A3B8" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/trip_icon_bg"
                            android:backgroundTint="@color/home_cyan_soft"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/ic_trip_route"
                            app:tint="@color/home_cyan" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/trip_distance"
                        style="@style/TripStatValue"
                        android:layout_marginTop="10dp"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/trip_0_00_km"
                        android:textColor="@color/home_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/trip_unit_km"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/trip_tile_bg"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TripStatLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/trip_duration"
                            android:textColor="#94A3B8" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/trip_icon_bg"
                            android:backgroundTint="#FFEDD5"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/ic_trip_timer"
                            app:tint="#F97316" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/trip_duration"
                        style="@style/TripStatValue"
                        android:layout_marginTop="10dp"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/trip_00_00_00"
                        android:textColor="@color/home_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/trip_unit_hms"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/trip_tile_bg"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TripStatLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/trip_max_speed"
                            android:textColor="#94A3B8" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/trip_icon_bg"
                            android:backgroundTint="#FEF9C3"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/ic_trip_bolt"
                            app:tint="#CA8A04" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/trip_max"
                        style="@style/TripStatValue"
                        android:layout_marginTop="10dp"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/trip_0_km_h"
                        android:textColor="@color/home_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/trip_peak_velocity"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/trip_tile_bg"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TripStatLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/trip_avg_speed"
                            android:textColor="#94A3B8" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/trip_icon_bg"
                            android:backgroundTint="@color/home_mint_soft"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/ic_trip_chart"
                            app:tint="@color/home_mint" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/trip_avg"
                        style="@style/TripStatValue"
                        android:layout_marginTop="10dp"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/trip_0_km_h"
                        android:textColor="@color/home_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/trip_moving_average"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Saved trips -->
            <LinearLayout
                android:id="@+id/trip_saved_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/trip_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/home_icon_circle"
                    android:backgroundTint="@color/home_cyan_soft"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_trip_history"
                    app:tint="@color/home_cyan" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trip_saved_trips"
                        android:textColor="@color/home_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trip_saved_trips_sub"
                        android:textColor="@color/home_text_2"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_trip_chevron"
                    app:tint="#94A3B8" />
            </LinearLayout>

            <!-- Advisory -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/trip_info_bg"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info"
                    app:tint="@color/home_cyan" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/trip_speed_and_distance_come_from_the_phone_s_gps_the"
                    android:textColor="#334155"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/trip_start"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="2"
            android:background="@drawable/home_cta_gradient"
            android:text="@string/trip_start"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_trip_play"
            app:iconGravity="textStart"
            app:iconTint="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/trip_reset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/trip_secondary_btn"
            android:text="@string/trip_reset"
            android:textAllCaps="false"
            android:textColor="@color/home_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_trip_reset"
            app:iconGravity="textStart"
            app:iconTint="@color/home_text" />
    </LinearLayout>
</LinearLayout>
