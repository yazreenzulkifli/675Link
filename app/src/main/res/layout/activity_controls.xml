<?xml version="1.0" encoding="utf-8"?>
<!-- Controls — "Super Red" redesign. All ids used by ControlsActivity are preserved. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controls_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ctl_bg_gradient"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/controls_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/controls_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/home_icon_circle"
                android:contentDescription="@string/controls_back"
                android:elevation="1dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                android:stateListAnimator="@animator/home_press"
                android:tint="@color/home_text" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ctl_dot_red" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/controls_title_dev"
                android:textColor="@color/home_text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/controls_drive_android_auto_without_touching_the_dash_typ"
            android:textColor="@color/home_text_2"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/controls_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:id="@+id/controls_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/card_pad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ctl_card_bg"
                android:elevation="4dp"
                android:orientation="vertical"
                android:outlineAmbientShadowColor="#1AFF0038"
                android:outlineSpotShadowColor="#26FF0038"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ctl_dot_red" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:letterSpacing="0.1"
                        android:text="@string/controls_on_screen_pad"
                        android:textAllCaps="true"
                        android:textColor="#B3BE123C"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_pad_fullscreen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ctl_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:stateListAnimator="@animator/home_press"
                        android:text="@string/controls_fullscreen_icon"
                        android:textColor="@color/ctl_rose_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/pad_intro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/controls_the_rotary_knob_steps_through_lists_the_arrows_j"
                    android:textColor="@color/home_text_2"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/volume_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_volume_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/controls_volume"
                            android:textColor="@color/home_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_volume_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ctl_badge"
                            android:gravity="center"
                            android:minWidth="28dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="@string/controls_8"
                            android:textColor="@color/ctl_rose_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_volume_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/controls_phone_media_volume_nav_voice_music_use_this_when"
                        android:textColor="@color/ctl_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/volume_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/controls_low"
                            android:textColor="@color/ctl_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <SeekBar
                            android:id="@+id/seek_volume"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:max="15"
                            android:maxHeight="6dp"
                            android:minHeight="6dp"
                            android:paddingVertical="12dp"
                            android:progress="8"
                            android:progressDrawable="@drawable/ctl_seek_track"
                            android:splitTrack="false"
                            android:thumb="@drawable/ctl_seek_thumb" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/controls_max"
                            android:textColor="@color/ctl_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- knob back / up / knob fwd -->
                <LinearLayout
                    android:id="@+id/pad_row_knob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_knob_back"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/ctl_key"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="56dp"
                        android:stateListAnimator="@animator/home_press"
                        android:text="@string/controls_prev"
                        android:textColor="@color/home_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_dpad_up"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/ctl_key"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="56dp"
                        android:stateListAnimator="@animator/home_press"
                        android:text="@string/controls_str"
                        android:textColor="@color/home_text"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/btn_knob_fwd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/ctl_key"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="56dp"
                        android:stateListAnimator="@animator/home_press"
                        android:text="@string/controls_next"
                        android:textColor="@color/home_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- left / OK / right -->
                <LinearLayout
                    android:id="@+id/pad_row_mid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_dpad_left"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/ctl_key"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="56dp"
                        android:stateListAnimator="@animator/home_press"
                        android:text="@string/controls_str_2"
                        android:textColor="@color/home_text"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/btn_select"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/ctl_ok"
                        android:clickable="true"
                        android:elevation="6dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:letterSpacing="0.05"
                        android:minHeight="56dp"
                        android:outlineSpotShadowColor="#80FF0038"
                        android:stateListAnimator="@animator/home_press"
                        android:text="@string/controls_ok"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_dpad_right"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/ctl_key"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="56dp"
                        android:stateListAnimator="@animator/home_press"
                        android:text="@string/controls_str_3"
                        android:textColor="@color/home_text"
                        android:textSize="20sp" />
                </LinearLayout>

                <!-- down -->
                <LinearLayout
                    android:id="@+id/pad_row_down"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btn_dpad_down"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/ctl_key"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="56dp"
                        android:stateListAnimator="@animator/home_press"
                        android:text="@string/controls_str_4"
                        android:textColor="@color/home_text"
                        android:textSize="20sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- back / home / voice -->
                <LinearLayout
                    android:id="@+id/pad_row_nav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_back"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/ctl_key"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="56dp"
                        android:stateListAnimator="@animator/home_press"
                        android:text="@string/controls_back"
                        android:textColor="@color/home_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_home"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/ctl_key"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="56dp"
                        android:stateListAnimator="@animator/home_press"
                        android:text="@string/controls_home"
                        android:textColor="@color/home_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_assistant"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/ctl_key_red"
                        android:clickable="true"
                        android:drawablePadding="6dp"
                        android:drawableStart="@drawable/ic_mic"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="56dp"
                        android:paddingHorizontal="10dp"
                        android:stateListAnimator="@animator/home_press"
                        android:text="@string/controls_voice"
                        android:textColor="@color/ctl_rose_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hardware remap advisory -->
            <LinearLayout
                android:id="@+id/controls_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/ctl_banner_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info"
                    android:tint="@color/ctl_red" />

                <TextView
                    android:id="@+id/tv_bike_settings_link"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/controls_remap_banner"
                    android:textColor="@color/home_text_2"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
