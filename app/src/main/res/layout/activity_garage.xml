<?xml version="1.0" encoding="utf-8"?>
<!-- Garage — light "Aero Glaze" redesign. All ids used by GarageActivity are preserved. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/garage_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_gradient"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/garage_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/home_icon_circle"
            android:contentDescription="@string/garage_back"
            android:elevation="1dp"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:stateListAnimator="@animator/home_press"
            android:tint="@color/home_text" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/garage_dot_cyan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/garage_garage"
            android:textColor="@color/home_text"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/garage_each_bike_keeps_its_own_name_photo_screen_fit_re"
                android:textColor="@color/home_text_2"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.1"
                    android:text="@string/garage_connected_vehicles"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/garage_paired_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/garage_pill_cyan"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="0"
                    android:textColor="#0891B2"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:id="@+id/garage_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="16dp"
                android:text="@string/garage_no_bikes_yet_scan_your_dash_qr_or_enter_wi_fi_na"
                android:textColor="@color/home_text_2"
                android:textSize="15sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/garage_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/garage_banner_bg"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info"
                    android:tint="@color/home_cyan" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/garage_auto_sync_hint"
                    android:textColor="#475569"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/garage_scan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/garage_btn_primary"
                    android:clickable="true"
                    android:contentDescription="@string/garage_scan_new_bike"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="14dp"
                    android:stateListAnimator="@animator/home_press">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_qr"
                        android:tint="@android:color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/garage_scan_bike"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/garage_manual"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/garage_btn_secondary"
                    android:clickable="true"
                    android:contentDescription="@string/garage_enter_wi_fi_manually"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="14dp"
                    android:stateListAnimator="@animator/home_press">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_wifi"
                        android:tint="@color/home_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/garage_wifi_setup"
                        android:textColor="@color/home_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Debug builds only: list / unlist the dummy bike (fake dash on 127.0.0.1). -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/garage_show_dummy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="56dp"
                android:text="Show dummy bike (test)"
                android:textColor="@color/home_text"
                android:textSize="14sp"
                android:visibility="gone"
                app:thumbTint="@color/garage_switch_thumb_tint"
                app:trackTint="@color/garage_switch_track"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
