<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trips_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_gradient"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/trips_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/home_icon_circle"
            android:contentDescription="@string/trip_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/home_text" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/home_dot"
            android:backgroundTint="@color/home_cyan" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/trip_saved_trips"
            android:textColor="@color/home_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/trips_import"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/trip_secondary_btn"
            android:clickable="true"
            android:drawableStart="@drawable/ic_trip_upload"
            android:drawablePadding="6dp"
            android:drawableTint="@color/home_text"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/trips_import_gpx"
            android:textColor="@color/home_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Day navigator -->
    <LinearLayout
        android:id="@+id/trips_day_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/trip_tile_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/trips_day_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/home_icon_circle"
            android:contentDescription="@string/trips_previous_day"
            android:padding="10dp"
            android:rotation="0"
            android:src="@drawable/ic_trip_chevron_left"
            app:tint="@color/home_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/home_dot"
                    android:backgroundTint="@color/home_mint" />

                <TextView
                    android:id="@+id/trips_day_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/home_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/trips_day_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/home_text_2"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/trips_day_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/home_icon_circle"
            android:contentDescription="@string/trips_next_day"
            android:padding="10dp"
            android:src="@drawable/ic_trip_chevron"
            app:tint="@color/home_text" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/trips_today"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/trips_today"
        android:textColor="@color/home_cyan"
        android:visibility="gone"
        app:rippleColor="@color/home_cyan" />

    <TextView
        android:id="@+id/trips_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:paddingHorizontal="32dp"
        android:text="@string/trips_no_rides_this_day"
        android:textColor="@color/home_text_2"
        android:textSize="15sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:id="@+id/trips_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp" />
    </ScrollView>
</LinearLayout>
