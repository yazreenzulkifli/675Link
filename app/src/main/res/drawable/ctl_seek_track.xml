<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/ctl_rose_rail" />
            <size android:height="6dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <gradient android:angle="0" android:startColor="#FDA4B4" android:endColor="@color/ctl_red" />
                <size android:height="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
