<?xml version="1.0" encoding="utf-8"?>
<!-- Tactile glass button (exit, theme, rotate, controls, fullscreen, up / down). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#3300B4D8">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#F2FFFFFF" />
            <stroke android:width="1dp" android:color="@color/home_border" />
        </shape>
    </item>
</ripple>
